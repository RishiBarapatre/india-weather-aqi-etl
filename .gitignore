# ─────────────────────────────────────────────────────────────
#  .gitignore — India Weather & AQI ETL Pipeline
# ─────────────────────────────────────────────────────────────

# Environment files (contain secrets!)
.env

# Airflow generated files
logs/
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Data files
data/raw/*.json
data/raw/*.csv
!data/raw/indian_cities.csv
!data/raw/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# PDF documentation
*.pdf
