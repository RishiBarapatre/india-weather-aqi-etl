# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values
#  Never commit .env to version control!
# ─────────────────────────────────────────────

# ── Airflow ───────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ── PostgreSQL — Airflow metadata DB ─────────
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# ── PostgreSQL — Warehouse (our DWH) ─────────
WAREHOUSE_POSTGRES_HOST=warehouse-postgres
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=warehouse_secret
WAREHOUSE_POSTGRES_DB=weather_aqi_dwh

# ── MongoDB ────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_secret
MONGO_DB=weather_aqi_raw

# ── External APIs ──────────────────────────────
# Open-Meteo is free — no key needed
# Get a free token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here
