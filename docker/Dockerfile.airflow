# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
#  Custom Airflow image — extends the official image with our
#  extra Python dependencies (rapidfuzz, tenacity, pymongo…)
# ─────────────────────────────────────────────────────────────
ARG AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3
FROM ${AIRFLOW_IMAGE_NAME}

USER root

# System-level build dependencies (needed by some Python wheels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install our project's Python requirements
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt
